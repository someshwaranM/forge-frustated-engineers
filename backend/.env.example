AWS_ACCESS_KEY_ID=<REPLACE_ME>
AWS_SECRET_ACCESS_KEY=<REPLACE_ME>
AWS_REGION=<REPLACE_ME>
AWS_BEDROCK_MODEL_ID=<REPLACE_ME>
GEMINI_API_KEY=<REPLACE_ME>
GEMINI_MODEL_ID=<REPLACE_ME>
SARVAM_API_KEY=<REPLACE_ME>
ELASTICSEARCH_URL=<REPLACE_ME>
ELASTICSEARCH_API_KEY=<REPLACE_ME>
MYSQL_HOST=<REPLACE_ME>
MYSQL_PORT=<REPLACE_ME>
MYSQL_DATABASE=<REPLACE_ME>
MYSQL_USER=<REPLACE_ME>
MYSQL_PASSWORD=<REPLACE_ME>

# Elastic Observability / APM (native elastic-apm Python agent — no OpenTelemetry)
# Obtain APM Server URL and Secret Token from Kibana -> Observability -> APM -> "Add data"
ELASTIC_APM_SERVER_URL=<REPLACE_ME>
ELASTIC_APM_SECRET_TOKEN=<REPLACE_ME>
ELASTIC_APM_SERVICE_NAME=vigil-backend
ELASTIC_APM_ENVIRONMENT=production
ELASTIC_APM_ENABLED=true

# Phase 15: Kibana Email Connector Delivery
KIBANA_BASE_URL=<REPLACE_ME>
KIBANA_CONNECTOR_ID=vigil-mail
ELASTIC_API_KEY=<REPLACE_ME>
EMAIL_REQUEST_TIMEOUT_SECONDS=20
MAX_REPORT_RECIPIENTS=5
VIGIL_INTERNAL_EMAIL_DOMAINS=vigil.com
VIGIL_APP_BASE_URL=http://localhost:5173
